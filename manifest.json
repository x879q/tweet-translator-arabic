{
  "manifest_version": 3,
  "name": "Tweet Translator to Arabic",
  "description": "Translate any tweet on X/Twitter to Arabic with one click",
  "version": "1.0.0",
  "permissions": [],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
